# Copy to .env for local dev. Never commit real keys.
DATABASE_URL=
# Stripe TEST keys (Dashboard → Developers → API keys). Leave blank to use the simulated checkout.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint pointing at https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Affiliate links / promo codes per provider (optional), e.g.:
# AFFILIATE_URL_WISE=
# PROMO_REMITLY=
